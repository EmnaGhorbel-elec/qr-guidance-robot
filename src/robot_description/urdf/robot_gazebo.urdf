<?xml version="1.0" encoding="utf-8"?>
<robot name="robot">

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0121459734710621 -0.000198241570210142 0.0449906840595474" rpy="0 0 0" />
      <mass value="1.00796524149794" />
      <inertia
        ixx="0.000664022840014205"
        ixy="3.36477372709559E-06"
        ixz="-6.46022439037541E-06"
        iyy="0.00190520705036307"
        iyz="5.00471440887707E-10"
        izz="0.00244406959005576" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159265" />
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL" />
      </geometry>
      <material name="yellow">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.012 0 0.045" rpy="0 0 3.14159265" />
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Left Rear Wheel -->
  <link name="left_rear_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0310322138231813" />
      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="leftrearwheel" type="continuous">
    <origin xyz="0.0588 -0.07355 0.011" rpy="-1.5708 0 -3.1416" />
    <parent link="base_link" />
    <child link="left_rear_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- Right Rear Wheel -->
  <link name="right_rear_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0310322138231813" />
      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="rightrearwheel" type="continuous">
    <origin xyz="0.058826 0.07355 0.011" rpy="-1.5708 0 -3.1416" />
    <parent link="base_link" />
    <child link="right_rear_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- Left Front Wheel -->
  <link name="left_front_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0310322138231813" />
      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <origin xyz="-0.058826 -0.07355 0.011" rpy="-1.5708 0 -3.1416" />
    <parent link="base_link" />
    <child link="left_front_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- Right Front Wheel -->
  <link name="right_front_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0310322138231806" />
      <inertia
        ixx="1.37618924502919E-05"
        ixy="0"
        ixz="0"
        iyy="1.3762060037714E-05"
        iyz="0"
        izz="2.28600342994278E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="rightfrontwheel" type="continuous">
    <origin xyz="-0.0588 0.07355 0.011" rpy="-1.5708 0 -3.1416" />
    <parent link="base_link" />
    <child link="right_front_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- LiDAR Link -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.125"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>
      <material name="lidar_jaune">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.068 0 0.12" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- Camera Link -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.03"/>
      </geometry>
      <material name="camera_jaune">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.03"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera on a PAN SERVO (SG90 on the real robot): rotation about z, left positive.
       Servo angle 90 = straight ahead = 0 rad here; 20..160 deg = -70..+70 deg.
       The pan axis is 0.15 m ahead of base_link: camera_offset in the mission parameters. -->
  <joint name="camera_pan_joint" type="revolute">
    <origin xyz="0.15 0 0.093" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2217" upper="1.2217" effort="1.0" velocity="6.0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <!-- Camera Optical Frame -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
  </joint>
  <!-- Différentiel : contrôle des roues -->
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <!-- names are swapped vs. position: wheels at y>0 are the LEFT side when facing +x -->
      <left_joint>rightrearwheel</left_joint>
      <left_joint>rightfrontwheel</left_joint>
      <right_joint>leftrearwheel</right_joint>
      <right_joint>left_front_wheel_joint</right_joint>
      <wheel_separation>0.1471</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <odom_publish_frequency>10</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <!-- Wheel odometry is NOT the robot's /odom: robot_sim/sim_base_node builds /odom like the
           real robot (position from speed, heading from the gyro) and publishes odom->base_link. -->
      <odom_topic>wheel_odom</odom_topic>
      <tf_topic>wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Camera pan servo: follows the angle published on camera_pan_cmd (rad) at <= 6 rad/s,
       like an SG90 (~0.1 s / 60 deg). Velocity mode: no PID to tune. -->
  <gazebo>
    <plugin filename="libignition-gazebo-joint-position-controller-system.so"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>camera_pan_joint</joint_name>
      <topic>camera_pan_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>6.0</cmd_max>
      <cmd_min>-6.0</cmd_min>
    </plugin>
  </gazebo>

  <!-- Joint angles (wheels + camera pan) -> /joint_states -> robot_state_publisher TF -->
  <gazebo>
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>

  <!-- Gyro (MPU-6050 on the real robot). Bias + noise so the heading drifts a little,
       as on the real robot; sim_base_node measures the bias at start like the bridge does. -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <topic>imu</topic>
      <imu>
        <angular_velocity>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.002</stddev>
              <bias_mean>0.004</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>

  <!-- Caméra simulée -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.02</near><far>10</far></clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>camera/image</topic>
    </sensor>
  </gazebo>

  <!-- LiDAR simulé -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>10.0</max><resolution>0.01</resolution></range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
</robot>
